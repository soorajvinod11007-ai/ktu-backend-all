# --- Runtime ---
ENVIRONMENT=dev
LOG_LEVEL=INFO

# --- Database ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/college_results
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/college_results_test

# --- Auth ---
# Must be >= 32 chars. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me-with-a-random-32-plus-char-string-please
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS (comma-separated) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20

# --- Seed (used only by scripts/seed.py) ---
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
